PORT=5000
PI_API_KEY=your_server_api_key_here
PI_API_BASE=https://api.minepi.com/v2
PI_NETWORK=mainnet
PI_WALLET=
APP_ORIGIN=http://localhost:3000

# Keep external x402 settlement disabled until a real verifier is configured.
ENABLE_X402=false
X402_FACILITATOR=
X402_VERIFY_URL=
X402_VERIFY_TOKEN=

# Used only for integrity receipts. This is NOT a PQC key.
INTEGRITY_HMAC_KEY=replace-with-a-long-random-secret
